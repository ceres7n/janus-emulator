// ProjectPAULA - tools/janus-launcher/janus_launcher.rc: the launcher window, the version
// information and the application manifest of JanusLauncher.exe. No icon on purpose (no game or
// brand artwork); Windows shows its default program icon.
#include <winresrc.h>
#include "resource.h"
#include "janus_launcher_version.h"   // generated by CMakeLists.txt from the project version

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

// asInvoker, Common Controls v6, DPI awareness, supported OS list. The linker runs with
// /MANIFEST:NO, so this is the only manifest in the exe.
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "JanusLauncher.manifest"

// The window. Dialog units scale with the Segoe UI 9 pt font, so the layout follows the
// display scaling (100-200 %). The full height (248 units) fits a 1920x1080 screen at 175 %.
// The "Advanced" part (y >= 136) is hidden and disabled at start; janus_launcher.cpp
// (set_advanced) cuts the window 7 units under the buttons and keeps it inside the screen.
// Tab order = the order of the controls here (top to bottom, as on screen).
IDD_MAIN DIALOGEX 0, 0, 340, 248
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "Janus Launcher"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Server address:", IDC_STATIC, 7, 9, 62, 8
    EDITTEXT        IDC_ADDRESS, 72, 7, 140, 14, ES_AUTOHSCROLL
    LTEXT           "IPv4 address or host name", IDC_STATIC, 218, 9, 115, 8
    LTEXT           "&Account:", IDC_STATIC, 7, 26, 62, 8
    EDITTEXT        IDC_ACCOUNT, 72, 24, 140, 14, ES_AUTOHSCROLL
    LTEXT           "1-18 letters, digits or _", IDC_STATIC, 218, 26, 115, 8
    AUTOCHECKBOX    "Close this &window when the game starts", IDC_CLOSE_ON_START, 72, 42, 220, 10
    LTEXT           "S&tatus:", IDC_STATIC, 7, 57, 62, 8
    EDITTEXT        IDC_STATUS, 7, 67, 326, 42, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    PUSHBUTTON      "A&dvanced >>", IDC_ADVANCED, 7, 115, 60, 14
    DEFPUSHBUTTON   "&Play", IDOK, 219, 115, 55, 14
    PUSHBUTTON      "Close", IDCANCEL, 278, 115, 55, 14

    GROUPBOX        "Advanced (the defaults work; the session key is not a password)", IDC_ADV_GROUP, 7, 136, 326, 105
    LTEXT           "C&lient:", IDC_CLIENT_LABEL, 15, 150, 50, 8
    EDITTEXT        IDC_CLIENT, 68, 148, 206, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "&Browse...", IDC_BROWSE, 278, 148, 47, 14
    LTEXT           "&Replace IPs:", IDC_REPLACE_LABEL, 15, 167, 50, 8
    EDITTEXT        IDC_REPLACE_IPS, 68, 165, 257, 14, ES_AUTOHSCROLL
    LTEXT           "Session &key:", IDC_KEY_LABEL, 15, 184, 50, 8
    EDITTEXT        IDC_KEY, 68, 182, 48, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "A&ge:", IDC_AGE_LABEL, 124, 184, 18, 8
    EDITTEXT        IDC_AGE, 144, 182, 24, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Game ID:", IDC_GAMEID_LABEL, 176, 184, 32, 8
    EDITTEXT        IDC_GAMEID, 210, 182, 44, 14, ES_AUTOHSCROLL | ES_READONLY | NOT WS_TABSTOP
    PUSHBUTTON      "Restore d&efaults", IDC_DEFAULTS, 258, 182, 67, 14
    LTEXT           "E&xtras:", IDC_EXTRAS_LABEL, 15, 201, 50, 8
    EDITTEXT        IDC_EXTRAS, 68, 199, 100, 14, ES_AUTOHSCROLL
    LTEXT           "Port: 9980 (built into this client)", IDC_PORT_INFO, 176, 201, 149, 8
    LTEXT           "Co&mmand line:", IDC_PREVIEW_LABEL, 15, 218, 50, 8
    EDITTEXT        IDC_PREVIEW, 68, 216, 257, 20, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    JL_VERSION_MAJOR, JL_VERSION_MINOR, JL_VERSION_PATCH, 0
 PRODUCTVERSION JL_VERSION_MAJOR, JL_VERSION_MINOR, JL_VERSION_PATCH, 0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", "Starts the Trickster client and points it at a ProjectPAULA server."
            VALUE "CompanyName", "Janus Emulator project"
            VALUE "FileDescription", "Janus Launcher - Trickster Online KR 2014 launcher"
            VALUE "FileVersion", JL_VERSION_STR
            VALUE "InternalName", "JanusLauncher"
            VALUE "LegalCopyright", "Janus Emulator contributors. GNU GPL v3."
            VALUE "OriginalFilename", "JanusLauncher.exe"
            VALUE "ProductName", "Janus Emulator"
            VALUE "ProductVersion", JL_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
